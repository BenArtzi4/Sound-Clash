# Sound Clash frontend: per-PR preview build env (`npm run build:preview`).
#
# Vite reads this when building with `--mode preview`. Like .env.production,
# every value here is baked into the browser bundle, so none of them is a
# secret. This file is a near-copy of .env.production on purpose: a preview is
# meant to look and behave exactly like prod, so it talks to the same API and
# the same Supabase project.
#
# Preview games are therefore REAL rows in prod's ephemeral tables
# (active_games / game_teams / game_rounds). That is deliberate and low-risk:
# those tables are swept by pg_cron 4 hours after creation, game creation is
# already unauthenticated in production, and the durable catalog (songs,
# genres) is untouchable without X-Admin-Password.
#
# The preview origin (https://pr-<N>.sound-clash.pages.dev) is admitted by the
# backend's CORS_ORIGIN_REGEX env var; without it set on Render, every FastAPI
# call from a preview fails CORS and no game can be created.
VITE_SUPABASE_URL=https://jvfddxuaqcsrguibkymp.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp2ZmRkeHVhcWNzcmd1aWJreW1wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgwODc1MDYsImV4cCI6MjA5MzY2MzUwNn0.dhQWQnHDwuZc2DolW98PQmCPdACi1O-4DFPuhKGUSpk
VITE_API_URL=https://api.soundclash.org

# Telemetry is deliberately BLANK in previews, and this is the one line that
# must not be "helpfully" filled in to match .env.production.
#
# Faro feeds Loki, and .github/workflows/stale-buzz-lock-scan.yml reads Loki on
# a schedule and AUTOMATICALLY FILES A GITHUB ISSUE per #254 incident it finds.
# A preview build pointed at the prod collector would let ordinary review
# clicking manufacture fake incident issues and pollute the Vitals dashboard
# with traffic that never happened in a real game. Sentry is blanked for the
# same reason: preview noise must not land in the prod error feed.
#
# Both are read by src/lib/telemetry.ts, which treats a blank URL as "disabled"
# and never loads the Faro chunk at all.
VITE_FARO_URL=
VITE_SENTRY_DSN=
