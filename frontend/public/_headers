/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://static.cloudflareinsights.com 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.soundclash.org https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://*.grafana.net

# Content-hashed build output. Vite writes a new filename whenever a chunk's
# bytes change, so a cached copy can never be stale: cache it forever and skip
# revalidation entirely. Previously these fell through to the platform default
# (max-age=0, must-revalidate), costing a 304 round-trip per asset on every
# load, including a player's mid-game refresh.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed static assets: their URL is stable across deploys, so they can only
# be busted by a new deploy, not a content hash. Cache for a day (a stale icon
# or manifest for under 24h is harmless, and index.html, which is
# never cached, still picks up a fresh deploy immediately). sw.js is
# deliberately NOT listed: it must always be fetched fresh so a new deploy's
# worker activates (see public/sw.js).
/icons/*
  Cache-Control: public, max-age=86400

# Self-hosted fonts: content is versioned by file name, safe to cache forever.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.jpg
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# index.html and every SPA route are intentionally left on the platform default
# (max-age=0, must-revalidate): the HTML must revalidate on every load so a
# deploy is picked up mid-session and never served stale over a live game.

# Keep one-off pages out of search results. Per-game and admin URLs carry a
# game code (or a password prompt) and mean nothing to a searcher; the bare
# entry pages /join, /display and /manager/create are NOT matched here and stay
# indexable. robots.txt still lets crawlers fetch these, or they would never
# see the header. See docs/seo.md.
/team/*
  X-Robots-Tag: noindex, nofollow
/manager/game/*
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow
/join/*
  X-Robots-Tag: noindex, nofollow
/display/*
  X-Robots-Tag: noindex, nofollow

# sound-clash.pages.dev is Cloudflare's alias for production: an identical copy
# of the site that must not compete with www.soundclash.org in search. This is
# Cloudflare's documented rule for that; it matches only the pages.dev host,
# never the custom domain.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
